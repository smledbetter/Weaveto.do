{
  "name": "weaveto.do",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "relay": "tsx server/relay.ts",
    "dev:all": "npm run relay & npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "csp:hash": "node scripts/csp-hash.mjs",
    "csp:hash:write": "node scripts/csp-hash.mjs --write",
    "csp:hash:check": "node scripts/csp-hash.mjs --check",
    "check:skips": "node scripts/check-test-skips.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "gate": "npm run check && npm run csp:hash:check && npm run check:skips && npm run test:unit && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@simplewebauthn/server": "^13.2.2",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-vercel": "^6.3.2",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "vodozemac-wasm-bindings": "^0.8.1",
    "ws": "^8.21.3"
  }
}
